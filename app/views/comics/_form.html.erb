<%= form_with(model: comic) do |form| %>
  <% if comic.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(comic.errors.count, "error") %> prohibited this comic from being saved:</h2>

      <ul>
        <% comic.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :issue_number, style: "display: block" %>
    <%= form.text_field :issue_number %>
  </div>

  <div>
    <%= form.label :legacy_issue, style: "display: block" %>
    <%= form.text_field :legacy_issue %>
  </div>

  <div>
    <%= form.label :cover_variant, style: "display: block" %>
    <%= form.text_field :cover_variant %>
  </div>

  <div>
    <%= form.label :publisher, style: "display: block" %>
    <%= form.text_field :publisher %>
  </div>

  <div>
    <%= form.label :copies, style: "display: block" %>
    <%= form.number_field :copies %>
  </div>

  <div>
    <%= form.label :purchase_date, style: "display: block" %>
    <%= form.date_field :purchase_date %>
  </div>

  <div>
    <%= form.label :cost, style: "display: block" %>
    <%= form.text_field :cost %>
  </div>

  <div>
    <%= form.label :box, style: "display: block" %>
    <%= form.text_field :box %>
  </div>

  <div>
    <%= form.label :comments, style: "display: block" %>
    <%= form.textarea :comments %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
