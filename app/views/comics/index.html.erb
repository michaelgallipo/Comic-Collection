<p style="color: green"><%= notice %></p>

<% content_for :title, "Comics" %>

<h1>Comics</h1>
<div>
  <%= link_to "New comic", new_comic_path %>
</div>

<div id="comics">
  <table>
    <thead>
      <tr>
        <th><%= sort_link('title', 'Title') %></th>
        <th>Issue</th>
        <th>Legacy No</th>
        <th>Cover Var</th>
        <th><%= sort_link('publisher', 'Publisher') %></th>
        <th>Copies</th>
        <th><%= sort_link('purchase_date', 'Purchase Date') %></th>
        <th>Cost</th>
        <th><%= sort_link('box', 'Box') %></th>
        <th>Comments</th>
      </tr>
    </thead>
    <tbody>
      <% @comics.each do |comic| %>
        <tr>
          <td class="no_underline"><%= link_to comic.title, comic %></td>
          <td><%= comic.formatted_issue %></td>
          <td><%= comic.formatted_legacy %></td>
          <td><%= comic.cover_variant %></td>
          <td><%= comic.publisher %></td>
          <td><%= comic.copies %></td>
          <td><%= comic.purchase_date %></td>
          <td><%= comic.cost %></td>
          <td><%= comic.box %></td>
          <td><%= comic.comments %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<br>
<br>
