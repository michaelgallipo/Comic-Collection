<div id="<%= dom_id comic %>">
  <div>
    <strong>Title:</strong>
    <%= comic.title %>
  </div>

  <div>
    <strong>Issue number:</strong>
    <%= comic.issue_number %>
  </div>

  <div>
    <strong>Legacy issue:</strong>
    <%= comic.legacy_issue %>
  </div>

  <div>
    <strong>Cover variant:</strong>
    <%= comic.cover_variant %>
  </div>

  <div>
    <strong>Publisher:</strong>
    <%= comic.publisher %>
  </div>

  <div>
    <strong>Purchase date:</strong>
    <%= comic.purchase_date %>
  </div>

  <div>
    <strong>Cost:</strong>
    <%= comic.cost %>
  </div>

  <div>
    <strong>Box:</strong>
    <%= comic.box %>
  </div>

  <div>
    <strong>Comments:</strong>
    <%= comic.comments %>
  </div>

</div>
